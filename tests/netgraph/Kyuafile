-- Kyuafile for PPPoE Load Balancer Tests
--
-- These tests are shell-based and output TAP (Test Anything Protocol) format.
-- Each test script must output TAP plan (e.g., "1..5") and results (e.g., "ok 1 - test name")
-- for proper kyua integration.
--
-- Usage:
--   kyua test [-v]              Run all tests
--   kyua test -t unit           Run unit tests only
--   kyua test -t regression    Run regression tests only

syntax(2)

test_suite("PPPoE Load Balancer")

-- Unit tests
tap_test_program{
    name = "ng_pppoe_lb_unit_test.sh",
    description = "Unit tests for ng_pppoe_lb kernel module",
    is_exclusive = true,
    required_user = "root",
    timeout = 300,
}

-- Configuration tests
tap_test_program{
    name = "ng_pppoe_lb_config_test.sh",
    description = "Configuration and sysctl interface tests",
    is_exclusive = true,
    required_user = "root",
    timeout = 180,
}

-- Regression tests
tap_test_program{
    name = "ng_pppoe_lb_regression_test.sh",
    description = "Regression tests for bug fixes",
    is_exclusive = true,
    required_user = "root",
    timeout = 300,
}

-- Integration tests
tap_test_program{
    name = "ng_pppoe_lb_integration_test.sh",
    description = "Full system integration tests",
    is_exclusive = true,
    required_user = "root",
    timeout = 600,
}

-- Stress tests
tap_test_program{
    name = "ng_pppoe_lb_stress_test.sh",
    description = "Stress and performance tests",
    is_exclusive = true,
    required_user = "root",
    timeout = 900,
}

-- VM environment tests
tap_test_program{
    name = "ng_pppoe_lb_vm_test.sh",
    description = "VM environment tests",
    is_exclusive = true,
    required_user = "root",
    timeout = 300,
}

-- Fuzz tests
tap_test_program{
    name = "ng_pppoe_lb_fuzz_test.sh",
    description = "Fuzzing tests for robustness testing",
    is_exclusive = true,
    required_user = "root",
    timeout = 600,
}
