# Basic netgraph setup fixture for PPPoE Load Balancer tests
#
# This script sets up a basic netgraph configuration with ng_pppoe_lb
# for use in automated tests.
#
# Usage:
#   ./test_basic_ng_setup [node_name]
#
# Variables set after running:
#   TEST_NODE - Name of created node
#   TEST_CLEANUP_REQUIRED - Set to "yes" if cleanup needed

set -e

# Configuration
NODE_NAME="${1:-pppoe_lb_test}"

echo "Setting up basic netgraph PPPoE LB fixture..."

# Create the netgraph node
# Hook name MUST be "ether" (NG_PPPOE_LB_HOOK_ETHER)
ngctl mkpeer . pppoe_lb ether "$NODE_NAME"

# Wait for node to be ready
sleep 0.5

# Verify node was created
if ngctl list 2>/dev/null | grep -q "$NODE_NAME"; then
    echo "Node created successfully: $NODE_NAME"
    export TEST_NODE="$NODE_NAME"
    export TEST_CLEANUP_REQUIRED="yes"
    exit 0
else
    echo "ERROR: Failed to create node: $NODE_NAME"
    exit 1
fi
