# =============================================================================
# SECTION 9: HEALTH CHECK SCRIPT
# =============================================================================

# Quick health check (paste into shell)
echo "=== PPPoE Load Balancer Health Check ==="
echo ""
echo "1. Module loaded:"
kldstat | grep pppoe_lb && echo "   OK" || echo "   FAILED"
echo ""
echo "2. Nodes exist:"
ngctl list | grep -q pppoe_lb && echo "   OK" || echo "   FAILED"
echo ""
echo "3. Governor enabled:"
sysctl -n net.graph.pppoe_lb.governor.enabled
echo ""
echo "4. Worker count:"
sysctl -n net.graph.pppoe_lb.governor.current_workers
echo ""
echo "5. Session count:"
sysctl -n net.graph.pppoe_lb.governor.total_sessions
echo ""
echo "6. CPU usage:"
sysctl -n net.graph.pppoe_lb.governor.cpu_usage"%
echo ""
echo "7. Error count:"
ngctl msg pppoe_lb0: getstats | grep -o 'errors=[0-9]*'
echo ""

# =============================================================================
# COMMON ISSUES AND RESOLUTIONS
# =============================================================================

# Issue: "No such file or directory" when running ngctl
# Cause: Kernel module not loaded
# Fix:   kldload ng_pppoe_lb

# Issue: "Protocol not supported"
# Cause: Netgraph not available or pppoe_lb node type unknown
# Fix:   kldload netgraph; kldload ng_pppoe_lb

# Issue: Governor not scaling
# Cause: Governor disabled or at max workers
# Fix:   sysctl net.graph.pppoe_lb.governor.enabled=1

# Issue: High error count
# Cause: Hardware issue, congestion, or configuration problem
# Fix:   Check network cables, switches, and system resources

# Issue: Unbalanced session distribution
# Cause: Hash algorithm or draining workers
# Fix:   Check worker states, consider round-robin algorithm
