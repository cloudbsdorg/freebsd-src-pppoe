# Bash completion for ngctl pppoe_lb subcommands
# Install: Copy to /usr/local/etc/bash_completion.d/
#   cp _ngctl_pppoe_lb /usr/local/etc/bash_completion.d/

_ngctl_pppoe_lb() {
    local cur prev words cword
    _init_completion || return

    local commands="show info config set stats statistics map sessions workers worker governor trigger"
    local algorithm_opts="0 1 2"
    local config_params="algorithm max_workers debug num_workers"
    local worker_states="0 1 2"
    local governor_decisions="none scale_up scale_down cancel no_action"

    case "$prev" in
        pppoe_lb)
            COMPREPLY=($(compgen -W "$commands" -- "$cur"))
            return 0
            ;;
        show|info)
            # Complete with netgraph paths
            _filedir
            return 0
            ;;
        config|set)
            if [[ "$cur" == *=* ]]; then
                # Complete value after =
                local param="${cur%%=*}"
                local val="${cur##*=}"
                case "$param" in
                    algorithm)
                        COMPREPLY=($(compgen -W "$algorithm_opts" -- "$val"))
                        ;;
                    max_workers|num_workers|debug)
                        COMPREPLY=($(compgen -W "0 1 2 4 8 10 16 32 64" -- "$val"))
                        ;;
                esac
            else
                # Complete parameter name
                COMPREPLY=($(compgen -W "$config_params" -S '=' -- "$cur"))
            fi
            return 0
            ;;
        stats|statistics)
            _filedir
            return 0
            ;;
        map|sessions)
            _filedir
            return 0
            ;;
        workers)
            if [[ "$cur" == *=* ]]; then
                _filedir
            else
                COMPREPLY=($(compgen -W "count state sessions" -S '=' -- "$cur"))
            fi
            return 0
            ;;
        worker)
            # worker N [command]
            COMPREPLY=($(compgen -W "state sessions" -- "$cur"))
            return 0
            ;;
        governor)
            COMPREPLY=($(compgen -W "status config" -- "$cur"))
            return 0
            ;;
        trigger)
            COMPREPLY=($(compgen -W "scale_up scale_down" -- "$cur"))
            return 0
            ;;
    esac

    # Default completion
    return 0
}

complete -F _ngctl_pppoe_lb ngctl
