# Bash completion for pppoed
# Install: Copy to /usr/local/etc/bash_completion.d/
#   cp _pppoed /usr/local/etc/bash_completion.d/

_pppoed() {
    local cur prev words cword
    _init_completion || return

    local algorithms="0 1 2"
    local worker_counts="1 2 4 8 16"
    local thresholds="10 20 30 40 50 60 70 80 90"

    case "$prev" in
        -P)
            _filedir
            return 0
            ;;
        -a|-p)
            # Complete provider names from ppp.conf
            local providers
            if [[ -f /etc/ppp/ppp.conf ]]; then
                providers=$(grep -E '^[a-zA-Z0-9_]+:' /etc/ppp/ppp.conf 2>/dev/null | cut -d: -f1)
                COMPREPLY=($(compgen -W "$providers" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "default" -- "$cur"))
            fi
            return 0
            ;;
        -e)
            _filedir -g '*'
            return 0
            ;;
        -n)
            COMPREPLY=($(compgen -W "1 2 3 4 5 6 7" -- "$cur"))
            return 0
            ;;
        -w|-G|-M)
            COMPREPLY=($(compgen -W "$worker_counts 0" -- "$cur"))
            return 0
            ;;
        -A)
            COMPREPLY=($(compgen -W "$algorithms" -- "$cur"))
            return 0
            ;;
        -I)
            COMPREPLY=($(compgen -W "1 2 5 10 15 30 60" -- "$cur"))
            return 0
            ;;
        -c|-C)
            COMPREPLY=($(compgen -W "$thresholds" -- "$cur"))
            return 0
            ;;
        -l)
            return 0
            ;;
        -F|-d|-L)
            return 0
            ;;
    esac

    # Complete options
    COMPREPLY=($(compgen -W '-F -d -P -a -e -l -n -p -L -w -A -G -M -I -c -C' -- "$cur"))

    # Complete interface names
    if [[ "$cur" != -* ]]; then
        local interfaces=$(ifconfig -l 2>/dev/null)
        COMPREPLY+=($(compgen -W "$interfaces" -- "$cur"))
    fi

    return 0
}

complete -F _pppoed pppoed
